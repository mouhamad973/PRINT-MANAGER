# ARKSEN PRINT MANAGER - variables d'environnement
# Copier vers .env et remplacer les secrets : cp .env.example .env
# Générer un secret : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Référence complète : docs/configuration.md

# --- Général ---
# cloud | on-premise : même code, comportement choisi par l'environnement.
DEPLOYMENT_MODE=cloud
NODE_ENV=production
# Adresse à laquelle les utilisateurs ouvrent l'application : seule origine acceptée à la connexion.
PUBLIC_WEB_URL=http://localhost:3000

# --- PostgreSQL ---
# Propriétaire de la base : utilisé uniquement pour les migrations.
POSTGRES_USER=arksen
POSTGRES_PASSWORD=remplacer-ce-mot-de-passe
POSTGRES_DB=arksen
# Rôles applicatifs créés par le service « migrate » (16 caractères minimum).
# arksen_app est soumis au Row-Level Security ; arksen_system sert à l'authentification.
APP_DB_PASSWORD=remplacer-mot-de-passe-app
SYSTEM_DB_PASSWORD=remplacer-mot-de-passe-system
# Port publié sur l'hôte. 15432 évite un conflit avec un PostgreSQL local sur 5432 ou 5433.
POSTGRES_HOST_PORT=15432

# --- Redis ---
REDIS_PASSWORD=remplacer-ce-mot-de-passe-aussi
# Port publié sur l'hôte. 16379 évite un conflit avec un Redis local sur 6379.
REDIS_HOST_PORT=16379

# --- Authentification ---
# Secret de signature des sessions (32 caractères minimum). Le changer déconnecte tout le monde.
BETTER_AUTH_SECRET=remplacer-par-un-secret-aleatoire-de-64-caracteres
# Premier Super Administrateur Arksen, créé au démarrage de l'API si aucun n'existe.
# Ces valeurs sont ignorées ensuite : vous pouvez les retirer après la première connexion.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

# --- Ports publiés sur l'hôte ---
API_HOST_PORT=4000
WEB_HOST_PORT=3000
ANALYTICS_HOST_PORT=8000

# --- Développement hors Docker (pnpm dev) ---
# Dans Docker, ces adresses sont construites par le fichier Compose à partir des valeurs ci-dessus.
# Les mots de passe ci-dessous doivent rester identiques à ceux définis plus haut.
DATABASE_URL=postgresql://arksen:remplacer-ce-mot-de-passe@localhost:15432/arksen
DATABASE_APP_URL=postgresql://arksen_app:remplacer-mot-de-passe-app@localhost:15432/arksen
DATABASE_SYSTEM_URL=postgresql://arksen_system:remplacer-mot-de-passe-system@localhost:15432/arksen
REDIS_URL=redis://:remplacer-ce-mot-de-passe-aussi@localhost:16379
ANALYTICS_URL=http://localhost:8000
API_INTERNAL_URL=http://localhost:4000
API_PORT=4000
