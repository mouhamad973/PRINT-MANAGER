// Schéma ARKSEN PRINT MANAGER.
// Conventions : modèles en PascalCase, tables et colonnes en snake_case.
// Toute table propre à une entreprise porte `tenant_id` et une politique RLS (voir les migrations).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Paramètres globaux de la plateforme, hors de tout tenant.
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// Entreprise cliente : l'unité d'isolation des données.
model Tenant {
  id           String       @id @default(uuid(7)) @db.Uuid
  name         String
  slug         String       @unique
  status       TenantStatus @default(ACTIVE)
  contactName  String?      @map("contact_name")
  contactEmail String?      @map("contact_email")
  contactPhone String?      @map("contact_phone")
  address      String?
  city         String?
  country      String?
  /// Devise des prix et des coûts de l'entreprise (ISO 4217).
  currency     String       @default("XOF")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  users              User[]
  auditLogs          AuditLog[]
  sites              Site[]
  printers           Printer[]
  printerModels      PrinterModel[]
  printerConnections PrinterConnection[]
  meterReadings      MeterReading[]
  tonerModels        TonerModel[]
  tonerPrices        TonerPrice[]
  calibrations       CalibrationProfile[]
  measurements       ConsumptionMeasurement[]
  printJobs          PrintJob[]
  printJobPages      PrintJobPage[]

  @@map("tenants")
}

enum UserRole {
  SUPER_ADMIN
  CLIENT_ADMIN
  PRINT_MANAGER
  TECHNICIAN
  STOCK_MANAGER
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

/// Utilisateur. Les champs de base sont ceux attendus par Better Auth.
/// Un Super Administrateur Arksen n'appartient à aucune entreprise (`tenantId` nul).
model User {
  id            String     @id
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false) @map("email_verified")
  image         String?
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  tenantId      String?    @map("tenant_id") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessions Session[]
  accounts Account[]

  @@index([tenantId])
  @@map("users")
}

model Session {
  id        String   @id
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Identifiants d'un utilisateur. Le mot de passe est haché par Better Auth (scrypt).
model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

/// Journal d'audit, en ajout seul. `tenantId` nul : événement de plateforme.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id")
  actorEmail  String?  @map("actor_email")
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// =====================================================================
// Phase 3 : sites, parc machines, fiches techniques, configuration réseau
// =====================================================================

/// Site d'une entreprise : agence, atelier, étage. Les machines y sont rattachées.
model Site {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  code         String?
  address      String?
  postalCode   String?  @map("postal_code")
  city         String?
  country      String?
  contactName  String?  @map("contact_name")
  contactEmail String?  @map("contact_email")
  contactPhone String?  @map("contact_phone")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  printers Printer[]

  @@unique([tenantId, name])
  /// Cible des clés étrangères composites : une machine ne peut pas pointer vers le site d'une autre entreprise.
  @@unique([id, tenantId])
  @@map("sites")
}

enum ColorMode {
  COLOR
  MONOCHROME
}

enum PrintTechnology {
  LASER
  LED
  INKJET
  OTHER
}

enum PaperFormat {
  A4
  A3
  SRA3
}

/// Fiche technique d'un modèle d'imprimante.
/// `tenantId` nul : catalogue Arksen, visible par toutes les entreprises et modifiable par la plateforme seule.
/// `tenantId` renseigné : modèle propre à une entreprise.
model PrinterModel {
  id                String          @id @default(uuid(7)) @db.Uuid
  tenantId          String?         @map("tenant_id") @db.Uuid
  manufacturer      String
  name              String
  colorMode         ColorMode       @map("color_mode")
  technology        PrintTechnology @default(LASER)
  maxFormat         PaperFormat     @default(A4) @map("max_format")
  speedMonoPpm      Int?            @map("speed_mono_ppm")
  speedColorPpm     Int?            @map("speed_color_ppm")
  duplex            Boolean         @default(true)
  monthlyDutyCycle  Int?            @map("monthly_duty_cycle")
  recommendedVolume Int?            @map("recommended_volume")
  notes             String?
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  printers Printer[]
  toners   TonerModel[]

  @@unique([tenantId, manufacturer, name])
  @@index([manufacturer, name])
  @@map("printer_models")
}

/// État d'exploitation, déclaré par les utilisateurs.
enum PrinterStatus {
  ACTIVE
  MAINTENANCE
  OUT_OF_SERVICE
  RETIRED
}

/// Joignabilité réseau, mesurée par l'agent (Phase 7). `UNKNOWN` tant qu'aucune mesure n'existe.
enum ConnectivityStatus {
  UNKNOWN
  ONLINE
  OFFLINE
}

/// Machine du parc.
model Printer {
  id           String             @id @default(uuid(7)) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  siteId       String             @map("site_id") @db.Uuid
  modelId      String             @map("model_id") @db.Uuid
  name         String
  serialNumber String             @map("serial_number")
  assetTag     String?            @map("asset_tag")
  location     String?
  status       PrinterStatus      @default(ACTIVE)
  connectivity ConnectivityStatus @default(UNKNOWN)
  lastSeenAt   DateTime?          @map("last_seen_at") @db.Timestamptz(3)
  installedAt  DateTime?          @map("installed_at") @db.Date
  notes        String?
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  site          Site                     @relation(fields: [siteId, tenantId], references: [id, tenantId], onDelete: Restrict)
  model         PrinterModel             @relation(fields: [modelId], references: [id], onDelete: Restrict)
  connection    PrinterConnection?
  meterReadings MeterReading[]
  calibration   CalibrationProfile?
  measurements  ConsumptionMeasurement[]
  printJobs     PrintJob[]

  @@unique([tenantId, serialNumber])
  @@unique([id, tenantId])
  @@index([tenantId, siteId])
  @@index([tenantId, status])
  @@index([modelId])
  @@map("printers")
}

enum SnmpVersion {
  V1
  V2C
  V3
}

enum SnmpSecurityLevel {
  NO_AUTH_NO_PRIV
  AUTH_NO_PRIV
  AUTH_PRIV
}

enum SnmpAuthProtocol {
  MD5
  SHA
  SHA224
  SHA256
  SHA384
  SHA512
}

enum SnmpPrivProtocol {
  DES
  AES128
  AES192
  AES256
}

/// Configuration réseau et SNMP d'une machine, utilisée par l'agent de collecte (Phase 7).
/// La communauté et les mots de passe SNMPv3 sont chiffrés (AES-256-GCM) et ne sont jamais renvoyés au navigateur.
model PrinterConnection {
  printerId         String             @id @map("printer_id") @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  ipAddress         String?            @map("ip_address")
  hostname          String?
  macAddress        String?            @map("mac_address")
  snmpVersion       SnmpVersion        @default(V2C) @map("snmp_version")
  snmpPort          Int                @default(161) @map("snmp_port")
  snmpCommunity     String?            @map("snmp_community")
  snmpUsername      String?            @map("snmp_username")
  snmpSecurityLevel SnmpSecurityLevel? @map("snmp_security_level")
  snmpAuthProtocol  SnmpAuthProtocol?  @map("snmp_auth_protocol")
  snmpAuthPassword  String?            @map("snmp_auth_password")
  snmpPrivProtocol  SnmpPrivProtocol?  @map("snmp_priv_protocol")
  snmpPrivPassword  String?            @map("snmp_priv_password")
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  printer Printer @relation(fields: [printerId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([printerId, tenantId])
  @@index([tenantId])
  @@map("printer_connections")
}

// =====================================================================
// Phase 4 : compteurs
// =====================================================================

enum MeterSource {
  MANUAL
  IMPORT
  AGENT
}

/// Relevé des compteurs d'une machine à un instant donné. Les volumes se déduisent des écarts entre relevés.
/// Une machine n'a qu'un relevé par instant : rejouer un import ou une synchronisation ne crée pas de doublon.
model MeterReading {
  id             String      @id @default(uuid(7)) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  printerId      String      @map("printer_id") @db.Uuid
  readAt         DateTime    @map("read_at") @db.Timestamptz(3)
  blackCount     Int         @map("black_count")
  /// Nul pour une machine noir et blanc.
  colorCount     Int?        @map("color_count")
  /// Toujours égal à noir + couleur (contrainte en base).
  totalCount     Int         @map("total_count")
  /// Compteur remis à zéro ou remplacé : aucun volume n'est calculé avec le relevé précédent.
  isReset        Boolean     @default(false) @map("is_reset")
  source         MeterSource @default(MANUAL)
  /// Identifiant fourni par l'émetteur (agent, import) pour l'idempotence.
  externalId     String?     @map("external_id") @db.Uuid
  notes          String?
  createdById    String?     @map("created_by_id")
  createdByEmail String?     @map("created_by_email")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  printer Printer @relation(fields: [printerId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([printerId, readAt])
  @@unique([tenantId, externalId])
  @@index([tenantId, readAt])
  @@map("meter_readings")
}

// =====================================================================
// Phase 5 : moteur de consommation CMJN
// =====================================================================

enum TonerChannel {
  CYAN
  MAGENTA
  YELLOW
  BLACK
}

/// Toner d'un canal d'un modèle d'imprimante : ses caractéristiques constructeur.
/// Il suit la fiche technique : catalogue Arksen (`tenantId` nul) ou propre à une entreprise.
model TonerModel {
  id                String       @id @default(uuid(7)) @db.Uuid
  tenantId          String?      @map("tenant_id") @db.Uuid
  printerModelId    String       @map("printer_model_id") @db.Uuid
  channel           TonerChannel
  /// Référence de la cartouche chez le constructeur.
  reference         String
  capacityGrams     Decimal      @map("capacity_grams") @db.Decimal(10, 2)
  yieldPages        Int          @map("yield_pages")
  /// Couverture à laquelle le rendement est mesuré, en pourcentage (5 % selon ISO/IEC 19752 et 19798).
  referenceCoverage Decimal      @default(5) @map("reference_coverage") @db.Decimal(5, 2)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  printerModel PrinterModel @relation(fields: [printerModelId], references: [id], onDelete: Cascade)
  prices       TonerPrice[]

  @@unique([printerModelId, channel])
  @@map("toner_models")
}

/// Prix d'achat d'une cartouche pour une entreprise, dans sa devise.
model TonerPrice {
  tenantId     String   @map("tenant_id") @db.Uuid
  tonerModelId String   @map("toner_model_id") @db.Uuid
  unitPrice    Decimal  @map("unit_price") @db.Decimal(14, 2)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tonerModel TonerModel @relation(fields: [tonerModelId], references: [id], onDelete: Cascade)

  @@id([tenantId, tonerModelId])
  @@map("toner_prices")
}

/// Paramètres de calcul d'une machine. Les couvertures sont l'aplat moyen supposé de ses impressions,
/// en attendant l'analyse des fichiers (Phase 6) ; les coefficients manuels remplacent la calibration automatique.
model CalibrationProfile {
  printerId          String      @id @map("printer_id") @db.Uuid
  tenantId           String      @map("tenant_id") @db.Uuid
  coverageCyan       Decimal     @default(5) @map("coverage_cyan") @db.Decimal(5, 2)
  coverageMagenta    Decimal     @default(5) @map("coverage_magenta") @db.Decimal(5, 2)
  coverageYellow     Decimal     @default(5) @map("coverage_yellow") @db.Decimal(5, 2)
  coverageBlack      Decimal     @default(5) @map("coverage_black") @db.Decimal(5, 2)
  paperFormat        PaperFormat @default(A4) @map("paper_format")
  mediaFactor        Decimal     @default(1) @map("media_factor") @db.Decimal(5, 3)
  coefficientCyan    Decimal?    @map("coefficient_cyan") @db.Decimal(6, 3)
  coefficientMagenta Decimal?    @map("coefficient_magenta") @db.Decimal(6, 3)
  coefficientYellow  Decimal?    @map("coefficient_yellow") @db.Decimal(6, 3)
  coefficientBlack   Decimal?    @map("coefficient_black") @db.Decimal(6, 3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  printer Printer @relation(fields: [printerId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([printerId, tenantId])
  @@index([tenantId])
  @@map("calibration_profiles")
}

/// Méthode d'une consommation réelle : pesée des cartouches (mesurée), ou nombre de cartouches
/// vidées multiplié par leur capacité (estimée).
enum MeasurementMethod {
  WEIGHING
  CARTRIDGES
}

/// Consommation réelle d'un canal sur une période, comparée au théorique et utilisée pour la calibration.
model ConsumptionMeasurement {
  id             String            @id @default(uuid(7)) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  printerId      String            @map("printer_id") @db.Uuid
  channel        TonerChannel
  periodStart    DateTime          @map("period_start") @db.Timestamptz(3)
  periodEnd      DateTime          @map("period_end") @db.Timestamptz(3)
  method         MeasurementMethod
  grams          Decimal           @db.Decimal(10, 2)
  /// Nombre de cartouches vidées, pour la méthode CARTRIDGES.
  cartridges     Decimal?          @db.Decimal(6, 2)
  notes          String?
  createdById    String?           @map("created_by_id")
  createdByEmail String?           @map("created_by_email")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  printer Printer @relation(fields: [printerId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, printerId, channel])
  @@map("consumption_measurements")
}

// =====================================================================
// Phase 6 : analyse PDF
// =====================================================================

/// Travail d'impression analysé avant production : un fichier PDF, sa machine prévue et ses exemplaires.
/// Le fichier n'est pas conservé : seules ses mesures le sont.
model PrintJob {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  name           String
  fileSize       Int      @map("file_size")
  /// Empreinte SHA-256 du fichier, pour reconnaître un fichier déjà analysé.
  fileSha256     String   @map("file_sha256")
  pageCount      Int      @map("page_count")
  colorPages     Int      @map("color_pages")
  /// Méthode de rendu et de séparation CMJN qui a produit les mesures.
  method         String
  dpi            Int
  averageCyan    Decimal  @map("average_cyan") @db.Decimal(6, 3)
  averageMagenta Decimal  @map("average_magenta") @db.Decimal(6, 3)
  averageYellow  Decimal  @map("average_yellow") @db.Decimal(6, 3)
  averageBlack   Decimal  @map("average_black") @db.Decimal(6, 3)
  /// Machine prévue, facultative ; elle doit appartenir à la même entreprise (déclencheur).
  printerId      String?  @map("printer_id") @db.Uuid
  copies         Int      @default(1)
  createdById    String?  @map("created_by_id")
  createdByEmail String?  @map("created_by_email")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  printer Printer?       @relation(fields: [printerId], references: [id], onDelete: SetNull)
  pages   PrintJobPage[]

  @@unique([id, tenantId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("print_jobs")
}

/// Mesures d'une page : format, dimensions et couverture CMJN (moyenne de teinte sur la surface).
model PrintJobPage {
  jobId           String  @map("job_id") @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  number          Int
  widthMm         Decimal @map("width_mm") @db.Decimal(7, 1)
  heightMm        Decimal @map("height_mm") @db.Decimal(7, 1)
  format          String
  orientation     String
  areaFactor      Decimal @map("area_factor") @db.Decimal(8, 4)
  coverageCyan    Decimal @map("coverage_cyan") @db.Decimal(6, 3)
  coverageMagenta Decimal @map("coverage_magenta") @db.Decimal(6, 3)
  coverageYellow  Decimal @map("coverage_yellow") @db.Decimal(6, 3)
  coverageBlack   Decimal @map("coverage_black") @db.Decimal(6, 3)
  coverageGray    Decimal @map("coverage_gray") @db.Decimal(6, 3)
  isColor         Boolean @map("is_color")

  tenant Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  job    PrintJob @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([jobId, number])
  @@map("print_job_pages")
}
