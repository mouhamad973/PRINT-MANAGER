# Frontal HTTPS d'ARKSEN PRINT MANAGER. Seul service publié sur l'hôte : il termine le TLS et
# relaie vers le frontend Next.js, qui relaie lui-même l'API sous /backend.
# Les variables ${...} sont remplacées au démarrage du conteneur (image officielle nginx) ;
# celles de nginx ($host, $remote_addr...) ne sont pas touchées.

upstream arksen_web {
    server web:3000;
    keepalive 16;
}

# Journal sans le corps des requêtes ni les cookies.
log_format arksen '$remote_addr [$time_local] "$request" $status $body_bytes_sent '
                  '$request_time "$http_user_agent"';

server {
    listen 80;
    listen [::]:80;
    server_name ${SERVER_NAME};
    server_tokens off;
    access_log /var/log/nginx/access.log arksen;

    # Validation Let's Encrypt (Cloud), servie en HTTP clair.
    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 ${PUBLIC_WEB_URL}$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SERVER_NAME};
    server_tokens off;
    access_log /var/log/nginx/access.log arksen;

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:arksen_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Fichiers PDF analysés (50 Mo) et imports de relevés.
    client_max_body_size 60m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        proxy_pass http://arksen_web;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # Remplace, et n'ajoute pas : un client ne peut pas usurper une adresse IP dans le
        # journal d'audit ni contourner la limitation des tentatives de connexion.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        # L'analyse d'un gros PDF peut durer jusqu'à deux minutes.
        proxy_connect_timeout 10s;
        proxy_send_timeout 130s;
        proxy_read_timeout 130s;
    }
}
