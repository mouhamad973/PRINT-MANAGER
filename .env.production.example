# ARKSEN PRINT MANAGER - production (Cloud ou On-Premise)
# Copier vers .env.production, remplacer chaque valeur, puis suivre docs/deployment.md.
# Générer un secret : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   ou : openssl rand -hex 32
# Ce fichier contient des secrets : droits 600, jamais dans Git.

# --- Adresse publique ---
# Nom DNS du serveur (certificat TLS et nginx).
SERVER_NAME=print.exemple.com
# Adresse à laquelle les utilisateurs ouvrent l'application, en https. Ajouter le port s'il
# n'est pas 443 : https://print.exemple.com:8443
PUBLIC_WEB_URL=https://print.exemple.com
# On-Premise : adresse IP du serveur, ajoutée au certificat pour un accès sans DNS (facultatif).
SERVER_IP=
# Cloud : adresse de contact Let's Encrypt (expiration des certificats).
ACME_EMAIL=
# Ports publiés par nginx.
HTTP_PORT=80
HTTPS_PORT=443

# --- PostgreSQL ---
POSTGRES_USER=arksen
POSTGRES_PASSWORD=
POSTGRES_DB=arksen
APP_DB_PASSWORD=
SYSTEM_DB_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=

# --- Authentification et chiffrement ---
BETTER_AUTH_SECRET=
# 64 caractères hexadécimaux. À sauvegarder à part : sans elle, les secrets SNMP sont perdus.
CREDENTIALS_ENCRYPTION_KEY=
# Premier Super Administrateur, créé au premier démarrage puis ignoré.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

# --- Conservation des données, en jours (vide : valeur par défaut) ---
# Journal d'audit : 1095 par défaut, 365 au minimum.
RETENTION_AUDIT_DAYS=
RETENTION_AGENT_EVENTS_DAYS=
RETENTION_SUPPLY_LEVELS_DAYS=
RETENTION_ALERTS_DAYS=
RETENTION_SYNC_LOGS_DAYS=

# --- Sauvegardes ---
# Dossier de l'hôte qui reçoit les sauvegardes (chemin absolu conseillé).
BACKUP_DIR=../../backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
